<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_music_school_lecture">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-field="o.course_id.name"/>
                            <div class="row">    
                                <div class="col-auto col-4 mw-100 mb-2">
                                    <strong>Professor:</strong>
                                    <span t-field="o.teacher_id"/>
                                </div>
                                <div class="col-auto col-4 mw-100 mb-2">
                                    <strong>Classroom:</strong>
                                    <span t-field="o.classroom_id.name"/>
                                </div>
                                <div class="col-auto col-4 mw-100 mb-2">
                                    <strong>Date:</strong>
                                    <span t-field="o.date"/>
                                </div>
                            </div>
                            <table class="table table-sm o_main_table table-bordered mt-4">
                                <thead>
                                    <tr>
                                        <th class="text-start">Student</th>
                                        <th class="text-start">Is Present</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.attendance_ids" t-as="attendance">
                                        <tr>
                                            <td><span t-field="attendance.student_id.name"/></td>
                                            <t t-if="attendance.is_present">
                                                <td><span>Yes</span></td>
                                            </t>
                                            <t t-else="">
                                                <td><span>No</span></td>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_music_school_lecture" model="ir.actions.report">
        <field name="name">Lecture Attendances</field>
        <field name="model">music.school.lecture</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">music_school_idris.report_music_school_lecture</field>
        <field name="report_file">music_school_idris.report_music_school_lecture</field>
        <field name="print_report_name">'%s' % object.course_id.name</field>
        <field name="paperformat_id" ref="paperformat_music_school"/>
        <field name="binding_model_id" ref="model_music_school_lecture"/>
        <field name="binding_type">report</field>
    </record>
</odoo>

