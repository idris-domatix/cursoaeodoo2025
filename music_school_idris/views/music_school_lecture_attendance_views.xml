<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="music_school_lecture_attendance_action" model="ir.actions.act_window">
        <field name="name">Lecture Attendance</field>
        <field name="res_model">music.school.lecture.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Create your first attendance record
        </p>
        </field>
    </record>

    <record id="music_school_lecture_attendance_view_list" model="ir.ui.view">

        <field name="name">music.school.lecture.attendance.list</field>
        <field name="model">music.school.lecture.attendance</field>
        <field name="arch" type="xml">
            <list string="Lecture Attendance">
                <field name="student_id"/>
                <field name="lecture_id"/>
                <field name="is_present" widget="boolean_toggle"/>
                <field name="notes"/>
                <field name="date"></field>
            </list>
        </field>
    </record>

    <record id="music_school_lecture_attendance_simple_view_tree" model="ir.ui.view">
        <field name="name">music.school.lecture.attendance.simple.view.tree</field>
        <field name="model">music.school.lecture.attendance</field>
        <field name="priority" eval='99'></field>
        <field name="arch" type="xml">
            <list string="Attendance" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="student_id"/>
                <field name="is_present" widget="boolean_toggle"/>
                <field name="date" widget="datetime"></field>
                
            </list>
        </field>
    </record>

</odoo>
